# ---------------------------------------------------------------------------
# Copy this file to .streamlit/secrets.toml (local) or paste its contents into
# Streamlit Cloud -> app settings -> Secrets. Never commit the real file:
# .streamlit/secrets.toml is gitignored.
# ---------------------------------------------------------------------------

# ---- Google sign-in (required) --------------------------------------------
#
# One-time setup in Google Cloud:
#
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create credentials -> OAuth client ID -> Application type: Web application
#   3. Under "Authorised redirect URIs" add exactly the redirect_uri below:
#        local:  http://localhost:8501/oauth2callback
#        cloud:  https://YOUR-APP.streamlit.app/oauth2callback
#      (add both if you run locally and on Streamlit Cloud)
#   4. On the OAuth consent screen, set the publishing status. While it is in
#      "Testing", every person who signs in must also be listed as a Test user.
#   5. Copy the client ID and client secret into the block below.
#
# cookie_secret is your own random string - it signs the session cookie.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

[auth.google]
client_id = "REPLACE.apps.googleusercontent.com"
client_secret = "REPLACE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"


# ---- Who is allowed in (optional) ----------------------------------------
#
# The allow-list is enforced in src/auth.py and ships with the three approved
# NEODRIFT accounts. Uncomment to override it for a particular deployment.
# Signing in with Google is never enough on its own - the address must also be
# on this list.

# ALLOWED_EMAILS = [
#   "auditorneodrift@gmail.com",
#   "neodriftoffice@gmail.com",
#   "admin@neodrift.in",
# ]


# ---- Source workbook (optional) ------------------------------------------
#
# Overrides the sheet key built into src/data.py. Take it from the
# /d/<SHEET_ID>/ part of the Google Sheets URL.

